# Base URL for your SAS Retrieval Agent Manager instance
RAM_URL=https://<your host here>

# Optional URL prefix. Set this at application run time, for example /ChatExtension.
# Leave empty when the app is served at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Optional SSO configuration. The device-code flow remains available without these values.
KEYCLOAK_CLIENT_ID=sas-ram-api
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
# Must be allowed in the Keycloak client's valid post-logout redirect URIs.
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# When NEXT_PUBLIC_BASE_PATH=/ChatExtension, these are automatically normalized
# to /ChatExtension/auth/callback and /ChatExtension/ by the server. Explicit
# prefixed URLs are also accepted.
# Use a long random value; changing it invalidates existing SSO sessions.
KEYCLOAK_SESSION_SECRET=replace-with-a-long-random-secret