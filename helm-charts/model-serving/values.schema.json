{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kserveCrd", "llmisvcCrd", "localModelCrd", "kserve", "llmisvc", "localModel", "runtimeConfigs"],
      "properties": {
        "kserveCrd": { "$ref": "#/definitions/component" },
        "llmisvcCrd": { "$ref": "#/definitions/component" },
        "localModelCrd": { "$ref": "#/definitions/component" },
        "kserve": { "$ref": "#/definitions/component" },
        "llmisvc": { "$ref": "#/definitions/component" },
        "localModel": { "$ref": "#/definitions/component" },
        "runtimeConfigs": { "$ref": "#/definitions/component" }
      }
    },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "commonAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "namespace": { "type": "string", "minLength": 1 },
    "hfSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "managed", "name", "token"],
      "properties": {
        "enabled": { "type": "boolean" },
        "managed": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "token": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "clusterServingRuntimes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openVINO", "vllmCPU"],
      "properties": {
        "openVINO": { "$ref": "#/definitions/runtime" },
        "vllmCPU": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name", "image", "imagePullPolicy", "maxModelLen", "gpuMemoryUtilization", "shmSize"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "image": { "type": "string", "minLength": 1 },
            "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
            "maxModelLen": { "type": "integer", "minimum": 1 },
            "gpuMemoryUtilization": { "type": ["string", "number"] },
            "shmSize": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "modelDefaults": { "$ref": "#/definitions/modelSettings" },
    "models": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/definitions/modelSettings" },
          {
            "type": "object",
            "required": ["name", "storageUri"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "storageUri": { "type": "string", "minLength": 1 },
              "injectHfToken": { "type": "boolean" },
              "namespace": { "type": "string" },
              "serviceAccountName": { "type": "string" }
            }
          }
        ]
      }
    },
    "llmDefaults": { "$ref": "#/definitions/llmSettings" },
    "llmInferenceServices": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/definitions/llmSettings" },
          {
            "type": "object",
            "required": ["name", "model"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "model": {
                "type": "object",
                "required": ["uri"],
                "properties": {
                  "uri": { "type": "string", "minLength": 1 },
                  "name": { "type": "string" }
                },
                "additionalProperties": true
              },
              "parallelism": { "type": "object", "additionalProperties": true },
              "worker": { "type": "object", "additionalProperties": true },
              "prefill": { "type": "object", "additionalProperties": true },
              "scaling": { "type": "object", "additionalProperties": true },
              "baseRefs": { "type": "array", "items": { "type": "string" } },
              "injectHfToken": { "type": "boolean" },
              "namespace": { "type": "string" }
            }
          }
        ]
      }
    },
    "kserve": { "type": "object", "additionalProperties": true },
    "kserve-crd": { "type": "object", "additionalProperties": true },
    "kserve-llmisvc-crd": { "type": "object", "additionalProperties": true },
    "kserve-localmodel-crd": { "type": "object", "additionalProperties": true },
    "kserve-resources": { "type": "object", "additionalProperties": true },
    "kserve-llmisvc-resources": { "type": "object", "additionalProperties": true },
    "kserve-localmodel-resources": { "type": "object", "additionalProperties": true },
    "kserve-runtime-configs": { "type": "object", "additionalProperties": true },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object", "additionalProperties": true }
  },
  "required": ["components", "namespace", "hfSecret", "serviceAccount", "clusterServingRuntimes", "modelDefaults", "models", "llmDefaults", "llmInferenceServices"],
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "resources": { "type": "object", "additionalProperties": true },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "name", "image", "imagePullPolicy", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "modelSettings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runtime": { "type": "string" },
        "modelFormat": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "object" } },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "llmSettings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "resources": { "$ref": "#/definitions/resources" },
        "router": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
